# ==========================================
# Directory Configuration
# ==========================================
# Input directory containing video files to process
TEMP_DIR=temp

# Output directory for extracted audio and transcripts
AUDIO_DIR=audio

# ==========================================
# Audio Extraction (ffmpeg)
# ==========================================
# Supported video file extensions (comma-separated)
VIDEO_EXTENSIONS=.mp4,.mov,.mkv,.avi,.m4v,.webm

# Codec and audio parameters for ffmpeg conversion
AUDIO_CODEC=libmp3lame
AUDIO_BITRATE=96k
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# ==========================================
# Audio Transcription (Whisper)
# ==========================================
# Whisper model to use: tiny, base, small, medium, large
WHISPER_MODEL=base

# Spoken audio language (e.g., pt, en, es). Leave empty for auto-detection.
WHISPER_LANGUAGE=

# Use FP16 half-precision (True/False). Set to False when running on CPU.
WHISPER_FP16=False

# Display detailed real-time transcription logs in console (True/False)
WHISPER_VERBOSE=True

# Suffix for the generated text transcription file
TRANSCRIPT_SUFFIX=_TRANSCRIPTION.txt
