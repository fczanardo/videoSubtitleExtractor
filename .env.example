# ==========================================
# Configurações de Diretórios
# ==========================================
# Diretório de entrada com os arquivos de vídeo
TEMP_DIR=temp

# Diretório de saída para os áudios extraídos e transcrições
AUDIO_DIR=audio

# ==========================================
# Extração de Áudio (ffmpeg)
# ==========================================
# Extensões de vídeo suportadas (separadas por vírgula)
VIDEO_EXTENSIONS=.mp4,.mov,.mkv,.avi,.m4v,.webm

# Codec e parâmetros do ffmpeg para conversão do áudio
AUDIO_CODEC=libmp3lame
AUDIO_BITRATE=96k
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# ==========================================
# Transcrição de Áudio (Whisper)
# ==========================================
# Modelo Whisper a ser utilizado: tiny, base, small, medium, large
WHISPER_MODEL=base

# Idioma do áudio (ex: pt, en, es). Deixe vazio para detecção automática.
WHISPER_LANGUAGE=

# Usar precisão FP16 (True/False). Definir como False ao rodar em CPU.
WHISPER_FP16=False

# Exibir logs detalhados de cada trecho transcrito no console (True/False)
WHISPER_VERBOSE=True

# Sufixo do arquivo de texto com a transcrição final gerada
TRANSCRIPT_SUFFIX=_TRANSCRICAO.txt
